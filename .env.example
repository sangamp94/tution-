# --- Neon Postgres ---
# From your Neon dashboard -> Connection Details.
# DATABASE_URL: the pooled connection (goes through PgBouncer) - used at runtime.
# DIRECT_URL:   the direct/unpooled connection - used by `prisma migrate`.
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.neon.tech/<db>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require"

# --- JWT ---
# Generate with: openssl rand -base64 32  (or generate-secret.vercel.app/32)
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="30d"

# That's it - materials store a pasted Google Drive link, so no Google
# service account / API credentials are needed anywhere in this project.
